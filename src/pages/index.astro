---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const preguntas = [
	{
		q: '¿Cómo recupero mi contraseña institucional?',
		a: 'Usa la opción de recuperación de Google con tu correo @liceoexperimental.cl. Si no puedes, contacta al Departamento de Informática.',
	},
	{
		q: '¿Dónde reservo un laboratorio?',
		a: 'Revisa la disponibilidad en Calendarios y coordina con el departamento según el laboratorio que necesites.',
	},
	{
		q: '¿Qué hago si un equipo no funciona?',
		a: 'Usa Reportar problema e indica sala, equipo y una breve descripción del fallo.',
	},
	{
		q: '¿Cómo puedo contactar al Departamento de Informática?',
		a: 'Puedes contactar al Departamento de Informática a través de correo electrónico en <a href="mailto:informatico@liceoexperimental.cl">informatico@liceoexperimental.cl</a> o a través de nuestro formulario de contacto.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🧑‍🚀 Hello, Astronaut!</h1>
			<p>Respuestas rápidas a dudas habituales de docentes y estudiantes.</p>

			{
				preguntas.map((item) => (
					<details class="faq-item">
						<summary>{item.q}</summary>
						<p>{item.a}</p>
					</details>
				))
			}
		</main>
		<Footer />
	</body>
</html>
