---
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import Layout from '../layouts/BlogPost.astro';
---

<Layout
	title="About Me"
	description="Lorem ipsum dolor sit amet"
	pubDate={new Date('August 08 2021')}
	heroImage={AboutHeroImage}
>
<section id="about" class="py-20">
	<div class="container mx-auto max-w-6xl px-6">
  
	  <div class="text-center mb-12">
		<span class="text-blue-600 font-semibold uppercase tracking-wider">
		  Departamento de Informática
		</span>
  
		<h2 class="text-4xl font-bold mt-2">
		  Acerca del Departamento
		</h2>
  
		<p class="mt-4 text-gray-600 max-w-3xl mx-auto">
		  El Departamento de Informática del Liceo Experimental UMAG es el
		  encargado de administrar y mantener la infraestructura tecnológica del
		  establecimiento, proporcionando soporte técnico y velando por el
		  correcto funcionamiento de los recursos informáticos utilizados por la
		  comunidad educativa.
		</p>
	  </div>
  
	  <div class="grid gap-8 md:grid-cols-2">
  
		<div class="rounded-xl border p-8">
		  <h3 class="text-2xl font-semibold mb-6">
			Funciones
		  </h3>
  
		  <ul class="space-y-3">
			<li>Administración y mantención de equipos computacionales.</li>
			<li>Gestión de la infraestructura de red e Internet.</li>
			<li>Instalación y actualización de software institucional.</li>
			<li>Administración de cuentas y servicios tecnológicos.</li>
			<li>Soporte técnico a docentes, asistentes y funcionarios.</li>
			<li>Apoyo tecnológico en actividades académicas e institucionales.</li>
			<li>Mantención preventiva y correctiva del equipamiento informático.</li>
		  </ul>
		</div>
  
		<div class="rounded-xl border p-8">
		  <h3 class="text-2xl font-semibold mb-6">
			Contacto
		  </h3>
  
		  <div class="space-y-5">
  
 
			<div>
			  <h4 class="font-semibold">Horario de atención</h4>
			  <p>
				Lunes a Jueves<br>
				07:30 - 13:00 hrs.<br>
				13:45 - 16:30 hrs.
			  </p>
			</div>
  
			<div>
			  <h4 class="font-semibold">Correo electrónico</h4>
			  <a href="mailto:informatica@liceoexperimental.cl">
				lsubiabre@liceoexperimental.cl
			  </a>
			</div>
  
		  </div>
		</div>
  
	  </div>
  
	</div>
  </section>
</Layout>
