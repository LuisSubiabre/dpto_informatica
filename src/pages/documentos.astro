---
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import Layout from '../layouts/BlogPost.astro';

const documentos = [
	{
		title: 'Disposiciones generales — Laboratorio de computación y carro móvil',
		description:
			'Normas de uso del laboratorio de computación y del carro móvil para la comunidad educativa.',
		embedUrl:
			'https://docs.google.com/document/d/1jFhnCz1ymwrpY61tBbq-TORh8DgW3K-tDF6RKVa_r-U/preview',
		openUrl:
			'https://docs.google.com/document/d/1jFhnCz1ymwrpY61tBbq-TORh8DgW3K-tDF6RKVa_r-U/edit?usp=sharing',
	},
];
---

<Layout
	title="Documentos"
	description="Documentos y disposiciones del Departamento de Informática del Liceo Experimental UMAG."
	pubDate={new Date('September 21 2026')}
	heroImage={AboutHeroImage}
>
	<p class="intro">
		Disposiciones y documentos institucionales relacionados con los recursos informáticos del
		establecimiento.
	</p>

	{
		documentos.map((doc) => (
			<section class="documento">
				<header class="documento-header">
					<div>
						<h2>{doc.title}</h2>
						<p>{doc.description}</p>
					</div>
					<a
						class="btn"
						href={doc.openUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						Abrir en Google Docs
						<span class="sr-only"> ({doc.title}, se abre en una pestaña nueva)</span>
					</a>
				</header>
				<iframe
					src={doc.embedUrl}
					title={doc.title}
					loading="lazy"
					allowfullscreen
				></iframe>
			</section>
		))
	}
</Layout>

<style>
	.intro {
		margin-bottom: 1.5em;
	}
	.documento + .documento {
		margin-top: 2.5em;
	}
	.documento-header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75em 1em;
		margin-bottom: 1em;
	}
	.documento-header h2 {
		margin: 0 0 0.35em;
		font-size: 1.35em;
		line-height: 1.3;
	}
	.documento-header p {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.95em;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		padding: 0.45em 1em;
		border-radius: 8px;
		font-weight: 700;
		font-size: 0.95em;
		text-decoration: none;
		line-height: 1.2;
		background: var(--accent);
		color: white;
		white-space: nowrap;
	}
	.btn:hover {
		background: var(--accent-dark);
		color: white;
	}
	.btn:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 2px;
	}
	.documento iframe {
		width: 100%;
		height: 720px;
		border: 1px solid rgba(var(--gray), 18%);
		border-radius: 12px;
		background: white;
	}
	@media (max-width: 560px) {
		.documento-header {
			flex-direction: column;
		}
		.btn {
			width: 100%;
		}
		.documento iframe {
			height: 560px;
		}
	}
</style>
